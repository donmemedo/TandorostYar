# Copy to .env. Never commit .env.
# DEMO=1 seeds demo users, prints OTP codes in the UI and enables fake top-ups. Local trials ONLY.
DEMO=0
# Required for POST /api/admin/settle (reachable only from inside the host). Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Keys the phone references in logs so they cannot be reversed. 32+ characters. Generate: openssl rand -hex 32
LOG_KEY=
# Your SMS provider's webhook; receives {"phone","code","text"}. Without it (and without DEMO) login answers 503.
SMS_WEBHOOK_URL=
SMS_HOURLY_BUDGET=300
# :80 for local/LAN, or your domain for automatic HTTPS (then also publish 443 in docker-compose.yml)
SITE_ADDRESS=:80
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=3330
